{
  "name": "typora-codex-mermaid",
  "version": "1.2.1",
  "description": "Codex-style Mermaid rendering and click-to-zoom previews for Typora on macOS",
  "scripts": {
    "extract": "node scripts/extract.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/verify.mjs",
    "install:typora": "/usr/bin/perl scripts/manage.pl install",
    "uninstall:typora": "/usr/bin/perl scripts/manage.pl uninstall",
    "test:installer": "python3 -m unittest discover -s tests -p test_installer.py",
    "prepare:public": "python3 scripts/prepare_public.py",
    "render:example": "node scripts/render_example.mjs",
    "package:mac": "python3 scripts/package_macos.py"
  },
  "keywords": [
    "typora",
    "mermaid",
    "diagrams",
    "macos"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "acorn": "^8.18.0",
    "esbuild": "^0.25.12",
    "eslint-scope": "^8.4.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "files": [
    ".gitattributes",
    ".github/workflows/checks.yml",
    ".gitignore",
    "CHANGELOG.md",
    "Install.command",
    "NOTICE",
    "README.md",
    "Uninstall.command",
    "docs/DEVELOPMENT.md",
    "docs/INSTALL.md",
    "examples/demo.md",
    "examples/knowledge-search.mmd",
    "examples/knowledge-search.svg",
    "examples/plugin-overview.mmd",
    "examples/plugin-overview.svg",
    "examples/publishing-workflow.mmd",
    "examples/publishing-workflow.svg",
    "examples/usage-preview.png",
    "package-lock.json",
    "package.json",
    "public-files.json",
    "scripts/build.mjs",
    "scripts/extract.mjs",
    "scripts/manage.pl",
    "scripts/package_macos.py",
    "scripts/prepare_public.py",
    "scripts/render_example.mjs",
    "scripts/verify.mjs",
    "src/plugin.js",
    "src/renderer.js",
    "src/viewer.js",
    "tests/checks.js",
    "tests/fixtures.json",
    "tests/parity.js",
    "tests/preview.html",
    "tests/test_installer.py",
    "tests/viewer-checks.js",
    "tests/word-export-checks.js"
  ]
}
